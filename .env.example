# Wix CLI / local app identity (names only — never commit real secrets)
WIX_CLOUD_PROVIDER=CLOUD_FLARE
WIX_CLIENT_ID=
WIX_CLIENT_INSTANCE_ID=
WIX_CLIENT_PUBLIC_KEY=
WIX_CLIENT_SECRET=

# Optional: provider keys should live in Wix Secrets Manager in production.
# Local DEV can fall back via getSecret() → process.env[NAME].
# Example secret names (create in Secrets Manager, not here):
# RESEND_API_KEY=
# TWILIO_AUTH_TOKEN=
